# Supabase: find both values in the Connect panel of your project
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Profilen man logger ind med på /login
LOGIN_EMAIL=din@email.dk
LOGIN_PASSWORD=dit-kodeord
# Hemmelig værdi der gemmes i en cookie, når man er logget ind (en lang tilfældig tekst)
LOGIN_SESSION=skriv-en-lang-tilfaeldig-tekst-her
